# Moku relay (proxy/): environment variables. On Vercel set them with `npx vercel env add <NAME> production`;
# locally, export them before `npm run local`. Never commit real values (this folder's .gitignore covers .env*).
# proxy/README.md describes each feature in full.

# --- Required --------------------------------------------------------------------------------------------------
# The Vercel AI Gateway key. It stays on the relay; brains only ever hold a Moku token.
AI_GATEWAY_API_KEY=
# The secret that signs install tokens (`moku1.<payload>.<hmac>`) from POST /v1/install and /v1/renew.
# Any long random string, e.g. `openssl rand -hex 32`. Without it installs answer 503.
MOKU_TOKEN_SECRET=

# --- Access (optional) -----------------------------------------------------------------------------------------
# Static tester tokens, as SHA-256 hashes only: "alice:<sha256>,bob:<sha256>" (npm run new-token -- <name>).
MOKU_TESTER_TOKENS=
# Invite codes, as hashes: "name:<sha256(code)>,…" (npm run new-invite -- <name>). Removing a name revokes it.
MOKU_INVITES=
# MOKU_INVITE_MACS=2              # Macs per invite
# MOKU_INSTALLS_PER_DAY=20        # new installs per address per day

# --- Limits (optional; defaults shown) -------------------------------------------------------------------------
# MOKU_RATE_PER_MINUTE=60
# MOKU_RATE_PER_DAY=3000
# MOKU_MAX_OUTPUT_TOKENS=1000
# MOKU_JUDGE_MODELS=typesafe-ai/jev
# MOKU_VOICE_MODELS=openai/gpt-6-luna
# MOKU_HEARTBEATS_PER_IP=100
# MOKU_EVENT_BATCHES_PER_IP=1000
# MOKU_WEB_ERRORS_PER_DAY=2000
# MOKU_WEB_VISITS_PER_DAY=50000

# --- Remote switches (optional) --------------------------------------------------------------------------------
# JSON overrides for /v1/flags, e.g. {"everyone":{"cloudJudging":true}} (npm run check-flags -- '<json>').
# MOKU_FLAGS=
# A Vercel Global Config (Edge Config) connection string; its `flags` item wins over MOKU_FLAGS.
# GLOBAL_CONFIG=
# EDGE_CONFIG=

# --- Shared limits (optional; recommended) ---------------------------------------------------------------------
# Upstash Redis REST credentials (either pair). Without them each function instance counts on its own.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Analytics (optional) --------------------------------------------------------------------------------------
# A PostHog project key (phc_…). Without it usage events, heartbeats and website errors are only logged.
# POSTHOG_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com

# --- Moku Pro through Dodo Payments (optional; without them /v1/checkout and /v1/dodo answer 503) ---------------
# DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_WEBHOOK_KEY=      # the webhook's whsec_ secret
# DODO_PRODUCT_MONTHLY=
# DODO_PRODUCT_YEARLY=
# DODO_ENVIRONMENT=               # live_mode; anything else is test mode
# DODO_TEST_DEVICES=              # in test mode, the Mac ids (comma-separated) that get a checkout
# MOKU_CHECKOUT_RETURN_URL=https://hellomoku.com/thanks

# --- Apple App Attest (optional) -------------------------------------------------------------------------------
# MOKU_ATTEST_APP_ID=<team id>.<bundle id>   # the App ID attestations must name (default: Moku's)

# --- Local only --------------------------------------------------------------------------------------------------
# PORT=8787                       # npm run local
