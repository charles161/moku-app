<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What Moku.app claims, only when scripts/sign-app.sh embeds a provisioning profile that grants it (docs/specs/app-attest.md §7).
     Claimed without that profile, macOS kills the app at launch. -->
<plist version="1.0"><dict>
  <key>com.apple.application-identifier</key><string>HTM2272E7P.ai.lightslips.moku</string>
  <key>com.apple.developer.team-identifier</key><string>HTM2272E7P</string>
  <key>com.apple.developer.devicecheck.appattest-environment</key><string>production</string>
</dict></plist>
